apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: {{ values.name }}
  annotations:
    kubernetes.io/ingress.class: nginx
    cert-manager.io/cluster-issuer: letsencrypt-prod
spec:
  tls:
    - hosts:
        - {{ values.name }}.example.com
      secretName: {{ values.name }}-tls
  rules:
    - host: {{ values.name }}.example.com
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: {{ values.name }}
                port:
                  number: 80

